<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="using:AvaloniaWebView"
        x:Class="DarkQuill.Views.HelpWindow"
        Title="DarkQuill — User Guide"
        Icon="/Assets/Icons/darkquill.ico"
        Width="920"
        Height="720"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#0e0e12">

  <wv:WebView x:Name="HelpWebView" />

</Window>
