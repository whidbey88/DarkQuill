<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DarkQuill.ViewModels"
        xmlns:controls="using:DarkQuill.Controls"
        xmlns:models="using:DarkQuill.Models"
        x:Class="DarkQuill.Views.AudioSettingsDialog"
        x:DataType="vm:AudioSettingsViewModel"
        Title="Audio Settings"
        Width="520"
        Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceContainerBrush}">

  <!-- Override font sizes to original values for this dialog -->
  <Window.Resources>
    <x:Double x:Key="HeadlineMediumFontSize">28</x:Double>
    <x:Double x:Key="HeadlineMediumLineHeight">36</x:Double>
    <x:Double x:Key="TitleSmallFontSize">16</x:Double>
    <x:Double x:Key="TitleSmallLineHeight">22</x:Double>
    <x:Double x:Key="TitleMediumFontSize">18</x:Double>
    <x:Double x:Key="TitleMediumLineHeight">24</x:Double>
    <x:Double x:Key="BodyLargeFontSize">16</x:Double>
    <x:Double x:Key="BodyLargeLineHeight">25.6</x:Double>
    <x:Double x:Key="BodyMediumFontSize">14</x:Double>
    <x:Double x:Key="BodyMediumLineHeight">22.4</x:Double>
    <x:Double x:Key="BodySmallFontSize">12</x:Double>
    <x:Double x:Key="BodySmallLineHeight">19.2</x:Double>
    <x:Double x:Key="LabelLargeFontSize">14</x:Double>
    <x:Double x:Key="LabelLargeLineHeight">20</x:Double>
    <x:Double x:Key="LabelMediumFontSize">12</x:Double>
    <x:Double x:Key="LabelMediumLineHeight">16</x:Double>
    <x:Double x:Key="LabelSmallFontSize">11</x:Double>
    <x:Double x:Key="LabelSmallLineHeight">16</x:Double>
  </Window.Resources>

  <Border Classes="Card" Margin="16">
    <DockPanel>

      <!-- Header -->
      <TextBlock DockPanel.Dock="Top"
                 Classes="HeadlineMedium"
                 Text="Audio Settings"
                 Foreground="{DynamicResource OnSurfaceBrush}"
                 Margin="0,0,0,20" />

      <!-- Button Row (Bottom) -->
      <StackPanel DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="12"
                  Margin="0,20,0,0">
        <Button Classes="Secondary"
                Content="Cancel"
                Command="{Binding CancelCommand}" />
        <Button Classes="Primary"
                Content="Apply"
                Command="{Binding ApplyCommand}" />
      </StackPanel>

      <!-- Status Message (above buttons) -->
      <TextBlock DockPanel.Dock="Bottom"
                 Classes="BodySmall"
                 Text="{Binding StatusMessage}"
                 Foreground="{DynamicResource OnSurfaceVariantBrush}"
                 Margin="0,12,0,0"
                 TextWrapping="Wrap" />

      <!-- Main Content -->
      <StackPanel Spacing="16">

        <!-- Loading Indicator -->
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    IsVisible="{Binding IsLoading}">
          <ProgressBar IsIndeterminate="True"
                       Width="100"
                       Height="4"
                       VerticalAlignment="Center" />
          <TextBlock Classes="BodySmall"
                     Text="Loading devices..."
                     Foreground="{DynamicResource OnSurfaceDimBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Device Selection Section -->
        <StackPanel Spacing="8">
          <TextBlock Classes="LabelMedium"
                     Text="Microphone Device"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <ComboBox ItemsSource="{Binding AvailableDevices}"
                    SelectedItem="{Binding SelectedDevice}"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="No devices found">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:AudioDevice">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- Input Level Section -->
        <StackPanel Spacing="8">
          <TextBlock Classes="LabelMedium"
                     Text="Input Level"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <Grid ColumnDefinitions="*,Auto">
            <Slider Grid.Column="0"
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding InputLevel}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True" />
            <TextBlock Grid.Column="1"
                       Classes="BodyMedium"
                       Text="{Binding InputLevel, StringFormat={}{0:0}%}"
                       Foreground="{DynamicResource OnSurfaceBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Width="40" />
          </Grid>
          <TextBlock Classes="BodySmall"
                     Text="Adjust until peaks touch the orange zone without entering red."
                     Foreground="{DynamicResource OnSurfaceDimBrush}" />
        </StackPanel>

        <!-- Test Section -->
        <StackPanel Spacing="8">
          <TextBlock Classes="LabelMedium"
                     Text="Test Microphone"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />

          <StackPanel Orientation="Horizontal" Spacing="12">
            <!-- Test Button (visible when not testing) -->
            <Button Classes="Secondary"
                    Content="Test"
                    Command="{Binding TestAudioCommand}"
                    IsVisible="{Binding !IsTesting}" />

            <!-- Testing indicator (visible when testing) -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        IsVisible="{Binding IsTesting}"
                        VerticalAlignment="Center">
              <ProgressBar IsIndeterminate="True"
                           Width="60"
                           Height="4"
                           VerticalAlignment="Center" />
              <TextBlock Classes="BodySmall"
                         Text="Testing..."
                         Foreground="{DynamicResource PrimaryContainerBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <!-- Test Level Meter -->
          <controls:AudioLevelMeter Level="{Binding TestAudioLevel}"
                                    IsVisible="{Binding IsTesting}" />
        </StackPanel>

      </StackPanel>
    </DockPanel>
  </Border>
</Window>
