<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DarkQuill.ViewModels"
        x:Class="DarkQuill.Views.ModelDownloadDialog"
        x:DataType="vm:ModelDownloadViewModel"
        Icon="/Assets/Icons/darkquill.ico"
        Title="Download Whisper Models"
        Width="520"
        Height="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceContainerBrush}">

  <!-- Override font sizes to original values for this dialog -->
  <Window.Resources>
    <x:Double x:Key="HeadlineMediumFontSize">28</x:Double>
    <x:Double x:Key="HeadlineMediumLineHeight">36</x:Double>
    <x:Double x:Key="TitleSmallFontSize">16</x:Double>
    <x:Double x:Key="TitleSmallLineHeight">22</x:Double>
    <x:Double x:Key="TitleMediumFontSize">18</x:Double>
    <x:Double x:Key="TitleMediumLineHeight">24</x:Double>
    <x:Double x:Key="BodyLargeFontSize">16</x:Double>
    <x:Double x:Key="BodyLargeLineHeight">25.6</x:Double>
    <x:Double x:Key="BodyMediumFontSize">14</x:Double>
    <x:Double x:Key="BodyMediumLineHeight">22.4</x:Double>
    <x:Double x:Key="BodySmallFontSize">12</x:Double>
    <x:Double x:Key="BodySmallLineHeight">19.2</x:Double>
    <x:Double x:Key="LabelLargeFontSize">14</x:Double>
    <x:Double x:Key="LabelLargeLineHeight">20</x:Double>
    <x:Double x:Key="LabelMediumFontSize">12</x:Double>
    <x:Double x:Key="LabelMediumLineHeight">16</x:Double>
    <x:Double x:Key="LabelSmallFontSize">11</x:Double>
    <x:Double x:Key="LabelSmallLineHeight">16</x:Double>
  </Window.Resources>

  <Border Classes="Card" Margin="16">
    <DockPanel>

      <!-- Header -->
      <TextBlock DockPanel.Dock="Top"
                 Classes="HeadlineMedium"
                 Text="Download Models"
                 Foreground="{DynamicResource OnSurfaceBrush}"
                 Margin="0,0,0,12" />

      <!-- Description -->
      <TextBlock DockPanel.Dock="Top"
                 Classes="BodyMedium"
                 Text="{Binding StatusMessage}"
                 Foreground="{DynamicResource OnSurfaceVariantBrush}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,20" />

      <!-- Cancel warning (Bottom) -->
      <TextBlock DockPanel.Dock="Bottom"
                 Classes="LabelSmall"
                 Text="Cancelling will close the application. Models are required for transcription."
                 Foreground="{DynamicResource OnSurfaceDimBrush}"
                 HorizontalAlignment="Right"
                 Margin="0,8,0,0"
                 IsVisible="{Binding !IsComplete}" />

      <!-- Button Row (Bottom) -->
      <StackPanel DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="12"
                  Margin="0,20,0,0">
        <!-- Cancel button — closes the application -->
        <Button Classes="Secondary"
                Content="Cancel"
                Command="{Binding CancelAndExitCommand}"
                IsVisible="{Binding !IsComplete}" />
        <!-- Download button -->
        <Button Classes="Primary"
                Content="Download Models"
                Command="{Binding DownloadModelsCommand}"
                IsVisible="{Binding !IsComplete}" />
        <!-- Done button (visible after completion) -->
        <Button Classes="Primary"
                Content="Done"
                Command="{Binding DoneCommand}"
                IsVisible="{Binding IsComplete}" />
      </StackPanel>

      <!-- Main Content -->
      <StackPanel Spacing="16">

        <!-- Models Folder Display -->
        <StackPanel Spacing="4">
          <TextBlock Classes="LabelMedium"
                     Text="Download Location"
                     Foreground="{DynamicResource OnSurfaceVariantBrush}" />
          <TextBlock Classes="BodySmall"
                     Text="{Binding ModelsFolder}"
                     Foreground="{DynamicResource OnSurfaceDimBrush}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ModelsFolder}" />
        </StackPanel>

        <!-- Base Model Progress -->
        <Border Background="{DynamicResource SurfaceBrush}"
                CornerRadius="8"
                Padding="16,12">
          <StackPanel Spacing="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left"
                         Classes="BodyMedium"
                         Text="ggml-base.bin"
                         Foreground="{DynamicResource OnSurfaceBrush}" />
              <TextBlock DockPanel.Dock="Right"
                         Classes="LabelMedium"
                         Text="{Binding BaseModelStatus}"
                         Foreground="{DynamicResource OnSurfaceVariantBrush}"
                         HorizontalAlignment="Right" />
            </DockPanel>
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding BaseModelProgress}"
                         Height="6"
                         CornerRadius="3"
                         Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Classes="LabelSmall"
                       Text="~142 MB — Fast, good for CPU-only systems"
                       Foreground="{DynamicResource OnSurfaceDimBrush}" />
          </StackPanel>
        </Border>

        <!-- Large v3 Turbo Model Progress -->
        <Border Background="{DynamicResource SurfaceBrush}"
                CornerRadius="8"
                Padding="16,12">
          <StackPanel Spacing="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left"
                         Classes="BodyMedium"
                         Text="ggml-large-v3-turbo.bin"
                         Foreground="{DynamicResource OnSurfaceBrush}" />
              <TextBlock DockPanel.Dock="Right"
                         Classes="LabelMedium"
                         Text="{Binding LargeModelStatus}"
                         Foreground="{DynamicResource OnSurfaceVariantBrush}"
                         HorizontalAlignment="Right" />
            </DockPanel>
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding LargeModelProgress}"
                         Height="6"
                         CornerRadius="3"
                         Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Classes="LabelSmall"
                       Text="~1.6 GB — Best accuracy, benefits from GPU (CUDA)"
                       Foreground="{DynamicResource OnSurfaceDimBrush}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </DockPanel>
  </Border>
</Window>
