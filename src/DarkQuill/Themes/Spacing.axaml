<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Spacing Scale (Double) -->
  <x:Double x:Key="Spacing2">2</x:Double>
  <x:Double x:Key="Spacing4">4</x:Double>
  <x:Double x:Key="Spacing8">8</x:Double>
  <x:Double x:Key="Spacing12">12</x:Double>
  <x:Double x:Key="Spacing16">16</x:Double>
  <x:Double x:Key="Spacing20">20</x:Double>
  <x:Double x:Key="Spacing24">24</x:Double>
  <x:Double x:Key="Spacing32">32</x:Double>
  <x:Double x:Key="Spacing40">40</x:Double>
  <x:Double x:Key="Spacing48">48</x:Double>

  <!-- Spacing Scale Aliases (backward compat) -->
  <x:Double x:Key="SpacingXxs">4</x:Double>
  <x:Double x:Key="SpacingXs">8</x:Double>
  <x:Double x:Key="SpacingSm">12</x:Double>
  <x:Double x:Key="SpacingMd">16</x:Double>
  <x:Double x:Key="SpacingLg">24</x:Double>
  <x:Double x:Key="SpacingXl">32</x:Double>
  <x:Double x:Key="SpacingXxl">48</x:Double>

  <!-- Uniform Thickness -->
  <Thickness x:Key="Spacing2Thickness">2</Thickness>
  <Thickness x:Key="Spacing4Thickness">4</Thickness>
  <Thickness x:Key="Spacing8Thickness">8</Thickness>
  <Thickness x:Key="Spacing12Thickness">12</Thickness>
  <Thickness x:Key="Spacing16Thickness">16</Thickness>
  <Thickness x:Key="Spacing20Thickness">20</Thickness>
  <Thickness x:Key="Spacing24Thickness">24</Thickness>
  <Thickness x:Key="Spacing32Thickness">32</Thickness>
  <Thickness x:Key="Spacing40Thickness">40</Thickness>

  <!-- Axis-Specific Thickness (Horizontal = Left,Right; Vertical = Top,Bottom) -->
  <Thickness x:Key="Horizontal16">16,0</Thickness>
  <Thickness x:Key="Horizontal24">24,0</Thickness>
  <Thickness x:Key="Vertical16">0,16</Thickness>
  <Thickness x:Key="Vertical24">0,24</Thickness>

  <!-- Common Padding Patterns -->
  <Thickness x:Key="PaddingCard">24,20</Thickness>
  <Thickness x:Key="PaddingButton">24,12</Thickness>
  <Thickness x:Key="PaddingSm">8</Thickness>
  <Thickness x:Key="PaddingMd">16</Thickness>
  <Thickness x:Key="PaddingLg">24</Thickness>

  <!-- Common Margin Patterns -->
  <Thickness x:Key="MarginListItem">0,0,0,8</Thickness>
  <Thickness x:Key="MarginSm">8</Thickness>
  <Thickness x:Key="MarginMd">16</Thickness>
  <Thickness x:Key="MarginLg">24</Thickness>

  <!-- Corner Radius -->
  <CornerRadius x:Key="CornerRadiusSm">8</CornerRadius>
  <CornerRadius x:Key="CornerRadiusMd">12</CornerRadius>
  <CornerRadius x:Key="CornerRadiusLg">16</CornerRadius>
  <CornerRadius x:Key="CornerRadiusXl">24</CornerRadius>
  <CornerRadius x:Key="CornerRadiusFull">999</CornerRadius>

</ResourceDictionary>
